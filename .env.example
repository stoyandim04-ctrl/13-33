# Copy to .env.local for `vercel dev`, and set the same names in the Vercel
# project (Settings → Environment Variables).
#
# Only VITE_* values reach the browser. Everything else stays on the server
# (the /api routes) - that is where the keys live.

# Public business e-mail, shown on the site.
VITE_CONTACT_EMAIL=

# --- server only ------------------------------------------------------------

# Supabase project "13-33" (Settings → API). The service-role key bypasses RLS:
# server only, never VITE_.
SUPABASE_URL=https://fuqixmjvsalzemxrbslp.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Claude for the project assistant (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=

# Password for /studio (the founder's panel). Long and unique.
STUDIO_PASSWORD=

# How clients see who they are writing with.
STUDIO_NAME=Основателят на 13:33

# Public address of the site, used in links in e-mails and notifications.
# The live address: https://digistudio13.com
SITE_URL=https://digistudio13.com

# Stripe (dashboard.stripe.com → Developers → API keys): the deposit is paid
# online. The webhook (Developers → Webhooks) points to
# https://<site>/api/pay?webhook with the event checkout.session.completed;
# its signing secret goes below. Without the webhook the page still settles
# the payment when the client comes back from Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com → API keys): e-mails to the client (brief received,
# deposit received). MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=13:33 <hello@digistudio13.com>
MAIL_REPLY_TO=

# Optional: a Telegram message to your phone on every new inquiry, message,
# accepted offer and booking, and on clicks on the main buttons (api/ping.ts). Create a bot with @BotFather, then send it a
# message and read your chat id from api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
