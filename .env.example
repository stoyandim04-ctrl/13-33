# Copy to .env.local and fill in. Only PUBLIC values belong here - everything
# prefixed VITE_ ends up in the browser bundle. Never put API keys here.

# Where the contact form POSTs (JSON). Without it nothing is sent and the form says so.
VITE_INQUIRY_ENDPOINT=

# Server route for the AI Project Brief (holds the AI provider key server-side).
VITE_AI_BRIEF_ENDPOINT=

# Public business e-mail, shown in the footer and used for the mailto fallback.
VITE_CONTACT_EMAIL=
